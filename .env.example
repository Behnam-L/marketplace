# Bajet — environment variables.
#
# `docker compose up` needs none of these: every secret is generated on first start
# into the `secrets` volume and passed to the containers as `<NAME>_FILE`.
# Copy this file to `.env` only to override defaults, or export the variables
# yourself when running the API outside Docker (see README.md → "Local development").
#
# Every variable can also be given as `<NAME>_FILE=/path/to/file`.

# ── Docker Compose ─────────────────────────────────────────────
WEB_PORT=8080                       # host port for the web app (API is proxied at /v1)
BOOTSTRAP_ADMIN_PHONE=09120000000   # phone of the first SuperAdmin
SEED_DEMO_DATA=true                 # demo plans, merchants and credit providers
COOKIE_SECURE=false                 # set true behind HTTPS
LOG_LEVEL=log

# ── API (only when running outside Docker) ─────────────────────
NODE_ENV=development
PORT=3000
# Either DATABASE_URL or DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
DATABASE_URL=postgres://bajet:CHANGE_ME@localhost:5432/bajet
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5173
# 32 random bytes, base64: `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=
# at least 16 characters: `openssl rand -hex 24`
HASH_PEPPER=
JOBS_ENABLED=true
MOCK_INTEGRATIONS=true
FILE_STORAGE_DIR=./storage
SWAGGER_ENABLED=true
CORS_ORIGINS=

# Used by `npm run seed` / `admin:bootstrap` / `demo:checkout`
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=
DEMO_MERCHANT_SECRET=
DEMO_API_URL=http://localhost:3000
