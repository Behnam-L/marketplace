{
  "name": "bajet-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Bâjet combined-credit payment platform (modular monolith)",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w @bajet/contracts && npm run build -w @bajet/api && npm run build -w @bajet/web",
    "lint": "eslint .",
    "test": "npm run test -w @bajet/contracts && npm run test -w @bajet/api && npm run test -w @bajet/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22"
  }
}
